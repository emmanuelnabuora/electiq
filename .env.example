# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electiq?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ElectIQ Copilot (Sprint 7) — optional; without it the Copilot reports
# it isn't configured rather than fabricating a response
ANTHROPIC_API_KEY=""

# App
NODE_ENV="development"
