# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electiq?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ElectIQ Copilot (Sprint 7) — optional; without it the Copilot reports
# it isn't configured rather than fabricating a response
ANTHROPIC_API_KEY=""

# Evidence-at-rest encryption (Sprint 11) — 32 raw bytes, base64-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EVIDENCE_ENCRYPTION_KEY=""

# App
NODE_ENV="development"
